+package it.unifi.ast.studyplanner.dto;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+import it.unifi.ast.studyplanner.entity.Priority;
+
+class FormTest {
+
+	@Test
+	void categoryFormStoresValues() {
+		CategoryForm form = new CategoryForm("AST", "Testing");
+		assertThat(form.getName()).isEqualTo("AST");
+		assertThat(form.getDescription()).isEqualTo("Testing");
+
+		CategoryForm emptyForm = new CategoryForm();
+		emptyForm.setName("Math");
+		emptyForm.setDescription("Math tasks");
+
+		assertThat(emptyForm.getName()).isEqualTo("Math");
+		assertThat(emptyForm.getDescription()).isEqualTo("Math tasks");
+	}
+
+	@Test
+	void studyTaskFormStoresValues() {
+		LocalDate dueDate = LocalDate.of(2026, 7, 10);
