@@ -0,0 +1,73 @@
+package it.unifi.ast.studyplanner.entity;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+
+import org.junit.jupiter.api.Test;
+
+class EntityTest {
+
+	@Test
+	void categoryStoresFieldsAndTimestamps() {
+		Category category = new Category("AST", "Testing course");
+
+		assertThat(category.getName()).isEqualTo("AST");
+		assertThat(category.getDescription()).isEqualTo("Testing course");
+		assertThat(category.getId()).isNull();
+
+		category.setName("Updated AST");
+		category.setDescription("Updated description");
+		category.onCreate();
+		LocalDateTime createdAt = category.getCreatedAt();
+		LocalDateTime updatedAt = category.getUpdatedAt();
+		category.onUpdate();
+
+		assertThat(category.getName()).isEqualTo("Updated AST");
+		assertThat(category.getDescription()).isEqualTo("Updated description");
+		assertThat(createdAt).isNotNull();
+		assertThat(updatedAt).isNotNull();
+		assertThat(category.getUpdatedAt()).isAfterOrEqualTo(updatedAt);
+	}
+
+	@Test
+	void studyTaskStoresFieldsStatusAndTimestamps() {
+		Category category = new Category("AST", "Testing course");
+		StudyTask task = new StudyTask("Write tests", "Description", Priority.HIGH,
+				LocalDate.of(2026, 7, 10), category);
+
+		assertThat(task.getId()).isNull();
+		assertThat(task.getTitle()).isEqualTo("Write tests");
+		assertThat(task.getDescription()).isEqualTo("Description");
+		assertThat(task.getPriority()).isEqualTo(Priority.HIGH);
+		assertThat(task.getDueDate()).isEqualTo(LocalDate.of(2026, 7, 10));
+		assertThat(task.getCategory()).isSameAs(category);
+		assertThat(task.getStatus()).isEqualTo(TaskStatus.PENDING);
+		assertThat(task.isCompleted()).isFalse();
+
+		task.setTitle("Updated");
+		task.setDescription("Updated description");
+		task.setPriority(Priority.LOW);
+		task.setDueDate(LocalDate.of(2026, 8, 1));
+		Category newCategory = new Category("Math", "Math course");
+		task.setCategory(newCategory);
+		task.markCompleted();
+		task.onCreate();
+		LocalDateTime updatedAt = task.getUpdatedAt();
+		task.onUpdate();
+
+		assertThat(task.getTitle()).isEqualTo("Updated");
+		assertThat(task.getDescription()).isEqualTo("Updated description");
+		assertThat(task.getPriority()).isEqualTo(Priority.LOW);
+		assertThat(task.getDueDate()).isEqualTo(LocalDate.of(2026, 8, 1));
+		assertThat(task.getCategory()).isSameAs(newCategory);
+		assertThat(task.isCompleted()).isTrue();
+		assertThat(task.getCreatedAt()).isNotNull();
+		assertThat(task.getUpdatedAt()).isAfterOrEqualTo(updatedAt);
+
+		task.markPending();
+		assertThat(task.getStatus()).isEqualTo(TaskStatus.PENDING);
+		assertThat(task.isCompleted()).isFalse();
+	}
+}
