@@ -0,0 +1,97 @@
+package it.unifi.ast.studyplanner.e2e;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Optional;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.util.LinkedMultiValueMap;
+import org.springframework.util.MultiValueMap;
+
+import it.unifi.ast.studyplanner.entity.Category;
+import it.unifi.ast.studyplanner.entity.StudyTask;
+import it.unifi.ast.studyplanner.entity.TaskStatus;
+import it.unifi.ast.studyplanner.repository.CategoryRepository;
+import it.unifi.ast.studyplanner.repository.StudyTaskRepository;
+import it.unifi.ast.studyplanner.support.AbstractPostgresContainerTest;
+
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+class StudyPlannerEndToEndTest extends AbstractPostgresContainerTest {
+
+	@Autowired
+	private TestRestTemplate restTemplate;
+
+	@Autowired
+	private CategoryRepository categoryRepository;
+
+	@Autowired
+	private StudyTaskRepository studyTaskRepository;
+
+	@Test
+	void userCanCreateCategoryCreateTaskAndCompleteTaskThroughHttp() {
+		ResponseEntity<String> home = restTemplate.getForEntity("/", String.class);
+		assertThat(home.getStatusCode()).isEqualTo(HttpStatus.OK);
+		assertThat(home.getBody()).contains("Dashboard");
+
+		ResponseEntity<String> categoryForm = restTemplate.getForEntity("/categories/new", String.class);
+		assertThat(categoryForm.getStatusCode()).isEqualTo(HttpStatus.OK);
+		assertThat(categoryForm.getBody()).contains("Create Category");
+
+		postForm("/categories", categoryForm("AST", "Automated Software Testing"));
+
+		Optional<Category> category = categoryRepository.findByName("AST");
+		assertThat(category).isPresent();
+
+		ResponseEntity<String> taskForm = restTemplate.getForEntity("/tasks/new", String.class);
+		assertThat(taskForm.getStatusCode()).isEqualTo(HttpStatus.OK);
+		assertThat(taskForm.getBody()).contains("Create Task");
+
+		postForm("/tasks", taskForm("Write report", "Prepare final report", "HIGH", "2026-07-10",
+				category.get().getId().toString()));
+
+		StudyTask task = studyTaskRepository.findByTitleContainingIgnoreCase("report").get(0);
+		assertThat(task.getStatus()).isEqualTo(TaskStatus.PENDING);
+
+		postForm("/tasks/" + task.getId() + "/complete", new LinkedMultiValueMap<>());
+
+		StudyTask completedTask = studyTaskRepository.findById(task.getId()).orElseThrow();
+		assertThat(completedTask.getStatus()).isEqualTo(TaskStatus.COMPLETED);
+
+		ResponseEntity<String> tasksPage = restTemplate.getForEntity("/tasks", String.class);
+		assertThat(tasksPage.getStatusCode()).isEqualTo(HttpStatus.OK);
+		assertThat(tasksPage.getBody()).contains("Write report");
+	}
+
+	private void postForm(String url, MultiValueMap<String, String> formData) {
+		HttpHeaders headers = new HttpHeaders();
+		headers.setContentType(MediaType.APPLICATION_FORM_URLENCODED);
+		ResponseEntity<String> response = restTemplate.postForEntity(url, new HttpEntity<>(formData, headers), String.class);
+		assertThat(response.getStatusCode().is3xxRedirection() || response.getStatusCode().is2xxSuccessful()).isTrue();
+	}
+
+	private MultiValueMap<String, String> categoryForm(String name, String description) {
+		MultiValueMap<String, String> formData = new LinkedMultiValueMap<>();
+		formData.add("name", name);
+		formData.add("description", description);
+		return formData;
+	}
+
+	private MultiValueMap<String, String> taskForm(String title, String description, String priority, String dueDate,
+			String categoryId) {
+		MultiValueMap<String, String> formData = new LinkedMultiValueMap<>();
+		formData.add("title", title);
+		formData.add("description", description);
+		formData.add("priority", priority);
+		formData.add("dueDate", dueDate);
+		formData.add("categoryId", categoryId);
+		return formData;
+	}
+}
